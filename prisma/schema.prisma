generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── AUTH ────────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  image         String?
  emailVerified DateTime?
  passwordHash  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts Account[]
  sessions Session[]

  exercises           Exercise[]
  workouts            Workout[]
  supplementSchedules SupplementSchedule[]
  supplementLogs      SupplementLog[]
  waterLogs           WaterLog[]
  sleepLogs           SleepLog[]
  incomeEntries       IncomeEntry[]
  expenses            Expense[]
  todoCompletions     TodoCompletion[]
  financeConfig       FinanceConfig?
  habits              Habit[]
  habitLogs           HabitLog[]
  weeklySummaries     WeeklySummary[]
  aiInsights          AIInsight[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── TO-DO COMPLETIONS (tracks GCal event completion locally) ────────

model TodoCompletion {
  id              String   @id @default(cuid())
  userId          String
  googleEventId   String
  completedAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, googleEventId])
  @@index([userId])
}

// ─── GYM ─────────────────────────────────────────────────────────────

enum MuscleGroup {
  CHEST
  BACK
  SHOULDERS
  BICEPS
  TRICEPS
  FOREARMS
  CORE
  QUADS
  HAMSTRINGS
  GLUTES
  CALVES
  FULL_BODY
}

enum ExerciseCategory {
  STRENGTH
  CARDIO
  FLEXIBILITY
  SPORT
}

enum DayType {
  PUSH
  PULL
  UPPER
  LOWER
  FULL_BODY
  CARDIO
  OTHER
}

model Exercise {
  id          String           @id @default(cuid())
  userId      String
  name        String
  muscleGroup MuscleGroup?
  category    ExerciseCategory @default(STRENGTH)
  isCustom    Boolean          @default(true)
  createdAt   DateTime         @default(now())

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  workoutSets WorkoutSet[]

  @@unique([userId, name])
  @@index([userId])
}

model Workout {
  id        String   @id @default(cuid())
  userId    String
  name      String
  dayType   DayType  @default(OTHER)
  notes     String?
  date      DateTime @default(now())
  duration  Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  workoutSets WorkoutSet[]

  @@index([userId])
  @@index([userId, date])
}

model WorkoutSet {
  id         String   @id @default(cuid())
  workoutId  String
  exerciseId String
  setNumber  Int
  reps       Int?
  weight     Float?
  duration   Int?
  distance   Float?
  notes      String?
  createdAt  DateTime @default(now())

  workout  Workout  @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  exercise Exercise @relation(fields: [exerciseId], references: [id])

  @@index([workoutId])
  @@index([exerciseId])
}

// ─── HEALTH / SUPPLEMENTS ────────────────────────────────────────────

enum TimeOfDay {
  MORNING
  EVENING
  NIGHT
}

model SupplementSchedule {
  id        String    @id @default(cuid())
  userId    String
  name      String
  dosage    String?
  timeOfDay TimeOfDay
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  logs SupplementLog[]

  @@index([userId])
}

model SupplementLog {
  id         String   @id @default(cuid())
  userId     String
  scheduleId String
  date       DateTime
  takenAt    DateTime @default(now())
  notes      String?

  user     User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  schedule SupplementSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  @@unique([scheduleId, date])
  @@index([userId, date])
}

model WaterLog {
  id        String   @id @default(cuid())
  userId    String
  date      DateTime
  glasses   Int      @default(0)
  goal      Int      @default(8)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId])
}

model SleepLog {
  id          String   @id @default(cuid())
  userId      String
  date        DateTime
  hoursSlept  Float
  quality     Int?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId])
}

// ─── AI INSIGHTS (generic cache for all AI-generated panels) ─────────

model AIInsight {
  id          String   @id @default(cuid())
  userId      String
  type        String   // "health_daily" | "finance_weekly"
  cacheKey    String   // date (YYYY-MM-DD) for daily, weekStart ISO for weekly
  content     String   @db.Text
  generatedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type, cacheKey])
  @@index([userId])
}

// ─── HABITS ──────────────────────────────────────────────────────────

model Habit {
  id        String     @id @default(cuid())
  userId    String
  name      String
  icon      String?
  isActive  Boolean    @default(true)
  createdAt DateTime   @default(now())

  user User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  logs HabitLog[]

  @@index([userId])
}

model HabitLog {
  id          String   @id @default(cuid())
  userId      String
  habitId     String
  date        DateTime
  completedAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  habit Habit @relation(fields: [habitId], references: [id], onDelete: Cascade)

  @@unique([habitId, date])
  @@index([userId, date])
}

// ─── AI WEEKLY SUMMARY ───────────────────────────────────────────────

model WeeklySummary {
  id            String   @id @default(cuid())
  userId        String
  weekStartDate DateTime
  summary       String   @db.Text
  highlights    String   @db.Text
  generatedAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, weekStartDate])
  @@index([userId])
}

// ─── FINANCE (built last) ────────────────────────────────────────────

enum BalanceTarget {
  FUND
  SKILL
  FLEX
}

model IncomeEntry {
  id        String   @id @default(cuid())
  userId    String
  amount    Float
  source    String?
  date      DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, date])
}

model Expense {
  id            String        @id @default(cuid())
  userId        String
  amount        Float
  category      String
  balanceTarget BalanceTarget
  description   String?
  date          DateTime      @default(now())
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, date])
}

// Per-user customization of the 4 finance buckets.
// Percentages are 0–100 and should sum to 100.
model FinanceConfig {
  userId      String @id
  lockedLabel String @default("Locked")
  fundLabel   String @default("Fun")
  skillLabel  String @default("Skill")
  flexLabel   String @default("Flex")
  lockedDesc  String @default("Reserved — do not spend")
  fundDesc    String @default("Fun activities & extras")
  skillDesc   String @default("Learning & self-improvement")
  flexDesc    String @default("Day-to-day spending")
  lockedPct   Float  @default(10)
  fundPct     Float  @default(22.5)
  skillPct    Float  @default(58.5)
  flexPct     Float  @default(9)
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
